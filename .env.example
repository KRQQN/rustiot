# Copy to .env and fill in. Used by the web server (cargo leptos watch) and by sqlx at compile time.

# Postgres (users, devices, dashboards)
DATABASE_URL=postgres://leptos:leptos@localhost:5432/leptos

# Secret used to sign session JWTs. Generate one with: openssl rand -base64 32
JWT_SECRET=change-me

# InfluxDB 3 (telemetry). The admin token is written to influx-token.json by the influxdb container.
INFLUX_HOST=http://localhost:8181
INFLUX_DATABASE=telemetry
INFLUX_TOKEN=
