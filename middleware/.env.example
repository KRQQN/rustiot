# Copy to middleware/.env. Values below are for the docker compose stack in this folder.
# When running the middleware outside Docker, use localhost for both hosts.

# MQTT broker (EMQX)
MQTT_HOST=emqx
MQTT_PORT=1883
MQTT_CLIENT_ID=rustiot-middleware
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEP_ALIVE=30

# InfluxDB 3. The token itself is read from /run/influx-data/influx-token.json (shared volume).
INFLUX_HOST=influxdb
INFLUX_PORT=8181
INFLUX_DATABASE=telemetry
